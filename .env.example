NODE_ENV=development

# Core services
# The local database/queue identifiers intentionally keep their historical `onbae`
# names so existing development volumes and deployments are not silently orphaned.
DATABASE_URL=postgresql://onbae:onbae@localhost:5432/onbae?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
NOEONE_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Legacy server-side alias accepted during migration. Prefer NOEONE_API_URL.
ONBAE_API_URL=

# Authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-high-entropy-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

# API security
# Required in production. Use at least 32 random characters.
ADMIN_API_KEY=replace-with-at-least-32-random-characters
# Send privileged requests with X-NOEONE-Admin-Key. X-Onbae-Admin-Key is
# temporarily accepted as a compatibility alias.
# Comma-separated exact browser origins allowed by the API and Better Auth.
CORS_ORIGINS=http://localhost:3000
# Default: false. In production never use trust-all. If the API is behind a
# reverse proxy/load balancer, set the exact proxy IP/CIDR values Fastify may trust.
TRUST_PROXY=false

# Consumer actor controls
USER_MODEL_ALLOWLIST=mock:nova-seed-v1,mock:echo-seed-v1
MAX_USER_ACTORS=10

# Provider credentials (optional until adapters are used)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Operational controls
MODEL_REQUEST_TIMEOUT_MS=45000
MAX_MODEL_TOKENS=2048
WORKER_CONCURRENCY=4
# NOEONE registry signature secret. This signs canonical acceptance records;
# external hosts sign their own Host Receipts with Ed25519 keys instead.
EVENT_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
LOG_LEVEL=info
