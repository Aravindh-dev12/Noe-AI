NODE_ENV=development

# Core services
DATABASE_URL=postgresql://onbae:onbae@localhost:5432/onbae?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
ONBAE_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Session/auth bootstrap
AUTH_SECRET=replace-with-at-least-32-random-characters

# Provider credentials (optional until adapters are used)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Operational controls
MODEL_REQUEST_TIMEOUT_MS=45000
MAX_MODEL_TOKENS=2048
EVENT_SIGNING_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info
