NODE_ENV=development

# Core services
DATABASE_URL=postgresql://onbae:onbae@localhost:5432/onbae?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
ONBAE_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-high-entropy-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

# API security
# Required in production. Use at least 32 random characters.
ADMIN_API_KEY=replace-with-at-least-32-random-characters
# Comma-separated exact origins allowed to call the API from browsers and trusted by Better Auth.
CORS_ORIGINS=http://localhost:3000
# Default: false. In production, never use `true` (trust-all). If the API is behind a
# reverse proxy/load balancer, set the exact proxy IP/CIDR values Fastify may trust,
# for example: 127.0.0.1,10.0.0.0/24
TRUST_PROXY=false

# Consumer actor controls
# provider:model pairs a signed-in user is allowed to select.
USER_MODEL_ALLOWLIST=mock:nova-seed-v1,mock:echo-seed-v1
MAX_USER_ACTORS=10

# Provider credentials (optional until adapters are used)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Operational controls
MODEL_REQUEST_TIMEOUT_MS=45000
MAX_MODEL_TOKENS=2048
WORKER_CONCURRENCY=4
EVENT_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
LOG_LEVEL=info
