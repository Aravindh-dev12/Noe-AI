generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActorType {
  USER
  PROVIDER
  RESEARCH
  ORGANIZATION
}

enum ActorStatus {
  ACTIVE
  PAUSED
  RETIRED
}

enum LineageKind {
  ORIGIN
  MIGRATION
  FORK
  MERGE
  RESTORE
}

enum ContinuityTransitionKind {
  MIGRATION
  RESTORE
  MERGE
}

enum ContinuityTransitionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum CanonicalStatus {
  ACCEPTED
  DISPUTED
  SUPERSEDED
}

enum EnvironmentStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum EvidenceValidationStatus {
  VERIFIED
  REJECTED
  REVOKED
}

enum CommitmentStatus {
  OPEN
  FULFILLED
  BREACHED
  CANCELLED
  DISPUTED
}

enum AuthorityGrantStatus {
  ACTIVE
  REVOKED
}

enum AuthorityExerciseCoverage {
  COVERED
  NOT_COVERED
}

enum ConsequenceAttributionDisposition {
  SUPPORTED
  NOT_SUPPORTED
  INDETERMINATE
  DISPUTED
}

enum ClaimStatus {
  FILED
  RESPONDED
  UNDER_REVIEW
  ADJUDICATED
  SETTLED
  DISMISSED
  WITHDRAWN
}

enum ClaimPartyRole {
  CLAIMANT
  RESPONDENT
  INTERESTED
}

enum ClaimActorRole {
  EXECUTOR
  DELEGATE
  SUBJECT
  COUNTERPARTY_AGENT
  WITNESS
}

enum AdjudicationDisposition {
  GRANTED
  PARTIALLY_GRANTED
  DENIED
  DISMISSED
  NO_JURISDICTION
}

enum RemedyStatus {
  ORDERED
  SATISFIED
  FAILED
  CANCELLED
}

model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  actors   Actor[]
  follows  Follow[]
  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Actor {
  id                 String      @id
  handle             String      @unique
  displayName        String
  description        String?
  avatarUrl          String?
  ownerId            String?
  actorType          ActorType
  status             ActorStatus @default(ACTIVE)
  canonicalLineageId String
  createdAt          DateTime
  updatedAt          DateTime    @updatedAt

  owner                   User?                     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  executions              ActorExecution[]
  lineage                 LineageNode[]
  continuityTransitions   ContinuityTransition[]
  parentAncestries        ActorAncestry[]            @relation("ancestry_parent")
  childAncestry           ActorAncestry?             @relation("ancestry_child")
  events                  ActorEvent[]
  hostReceipts            HostReceipt[]
  evidenceBindings        ActorEvidenceBinding[]
  debtorCommitments       Commitment[]               @relation("commitment_debtor")
  creditorCommitments     Commitment[]               @relation("commitment_creditor")
  authorityGrants         AuthorityGrant[]            @relation("authority_subject")
  authorityExercises      AuthorityExercise[]
  consequenceAttributions ConsequenceAttribution[]
  claimLinks              ClaimActorLink[]
  followers               Follow[]
  subjectEdges            RelationshipEdge[]         @relation("relationship_subject")
  objectEdges             RelationshipEdge[]         @relation("relationship_object")
  matchesA                Match[]                    @relation("match_actor_a")
  matchesB                Match[]                    @relation("match_actor_b")
  winnerMatches           Match[]                    @relation("match_winner")

  @@index([ownerId])
  @@index([actorType, status])
  @@index([createdAt])
}

model ActorExecution {
  id         String    @id
  actorId    String
  provider   String
  model      String
  runtime    String?
  configHash String
  startedAt  DateTime
  endedAt    DateTime?
  metadata   Json      @default("{}")

  actor              Actor               @relation(fields: [actorId], references: [id], onDelete: Cascade)
  events             ActorEvent[]
  hostReceipts       HostReceipt[]
  authorityExercises AuthorityExercise[]

  @@index([actorId, startedAt])
  @@index([provider, model])
}

model LineageNode {
  id           String      @id
  actorId      String
  parentNodeId String?
  kind         LineageKind
  canonical    Boolean     @default(false)
  createdAt    DateTime
  metadata     Json        @default("{}")

  actor    Actor         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  parent   LineageNode?  @relation("lineage_parent", fields: [parentNodeId], references: [id], onDelete: SetNull)
  children LineageNode[] @relation("lineage_parent")

  @@index([actorId, canonical])
  @@index([parentNodeId])
}

model ContinuityTransition {
  id                     String                     @id
  actorId                String
  kind                   ContinuityTransitionKind
  status                 ContinuityTransitionStatus @default(PROPOSED)
  predecessorLineageId   String
  predecessorExecutionId String
  proposedProvider       String
  proposedModel          String
  proposedRuntime        String?
  proposedConfigHash     String
  resultingExecutionId   String?                    @unique
  resultingLineageId     String?                    @unique
  proposedByType         String
  proposedById           String?
  policyVersion          String
  idempotencyKey         String                     @unique
  reason                 String?
  changeSet              Json                       @default("{}")
  proposedAt             DateTime                   @default(now())
  decidedAt              DateTime?
  decisionReason         String?

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, proposedAt])
  @@index([actorId, status, proposedAt])
  @@index([predecessorLineageId])
}

model ActorAncestry {
  id                  String   @id
  childActorId        String   @unique
  parentActorId       String
  sourceLineageId     String
  sourceEventSequence Int?
  sourceEventHash     String?
  reason              String?
  createdAt           DateTime @default(now())

  parentActor Actor @relation("ancestry_parent", fields: [parentActorId], references: [id], onDelete: Restrict)
  childActor  Actor @relation("ancestry_child", fields: [childActorId], references: [id], onDelete: Cascade)

  @@index([parentActorId, createdAt])
  @@index([sourceLineageId])
}

model Host {
  id          String   @id
  slug        String   @unique
  displayName String
  publicKey   String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  environments Environment[]
  events       ActorEvent[]
  keys         HostKey[]
  receipts     HostReceipt[]
}

model HostKey {
  id           String    @id
  hostId       String
  algorithm    String    @default("ed25519")
  publicKeyPem String
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  retiredAt    DateTime?

  host     Host          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  receipts HostReceipt[]

  @@index([hostId, status])
}

model Environment {
  id          String            @id
  hostId      String
  slug        String
  displayName String
  version     String
  status      EnvironmentStatus @default(ACTIVE)
  config      Json              @default("{}")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  host         Host          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  matches      Match[]
  hostReceipts HostReceipt[]

  @@unique([hostId, slug, version])
  @@index([slug, status])
}

model ActorEvent {
  id                 String          @id
  actorId            String
  sequence           Int
  executionId        String?
  hostId             String
  type               String
  sourceKey          String?         @unique
  occurredAt         DateTime
  observedAt         DateTime
  environmentVersion String
  payload            Json
  issuer             String
  signature          String?
  previousEventHash  String?
  hash               String          @unique
  canonicalStatus    CanonicalStatus @default(ACCEPTED)
  createdAt          DateTime        @default(now())

  actor       Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  execution   ActorExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  host        Host            @relation(fields: [hostId], references: [id], onDelete: Restrict)
  hostReceipt HostReceipt?

  @@unique([actorId, sequence])
  @@index([actorId, occurredAt])
  @@index([actorId, canonicalStatus, occurredAt])
  @@index([type, occurredAt])
  @@index([hostId, occurredAt])
}

model HostReceipt {
  id                 String   @id
  version            String
  receiptId          String
  hostId             String
  keyId              String
  actorId            String
  executionId        String?
  environmentId      String
  actorEventId       String   @unique
  type               String
  occurredAt         DateTime
  environmentVersion String
  payload            Json
  signature          String
  contentHash        String   @unique
  receivedAt         DateTime @default(now())

  host        Host            @relation(fields: [hostId], references: [id], onDelete: Restrict)
  hostKey     HostKey         @relation(fields: [keyId], references: [id], onDelete: Restrict)
  actor       Actor           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  execution   ActorExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  environment Environment     @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  actorEvent  ActorEvent      @relation(fields: [actorEventId], references: [id], onDelete: Cascade)

  @@unique([hostId, receiptId])
  @@index([actorId, occurredAt])
  @@index([hostId, occurredAt])
  @@index([keyId, receivedAt])
}

model EvidenceArtifact {
  id              String   @id
  kind            String
  issuer          String
  externalId      String?
  uri             String?
  digest          String
  digestAlgorithm String   @default("sha256")
  observedAt      DateTime
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  bindings                     ActorEvidenceBinding[]
  validations                  EvidenceValidation[]
  sourceCommitments            Commitment[]             @relation("commitment_source_evidence")
  commitmentTransitions        CommitmentTransition[]   @relation("commitment_transition_evidence")
  authorityGrants              AuthorityGrant[]          @relation("authority_evidence")
  authorityExercises           AuthorityExercise[]       @relation("authority_exercise_evidence")
  consequenceObservations      ConsequenceObservation[]  @relation("consequence_source_evidence")
  consequenceAttributions      ConsequenceAttribution[]  @relation("consequence_attribution_evidence")
  legalContextSources          LegalContextSnapshot[]    @relation("legal_context_source_evidence")
  legalContextAcceptances      LegalContextSnapshot[]    @relation("legal_context_acceptance_evidence")
  claimStatements              Claim[]                   @relation("claim_statement_evidence")
  claimPartyIdentities         ClaimParty[]              @relation("claim_party_identity_evidence")
  claimEvidenceBindings        ClaimEvidenceBinding[]
  claimTransitions             ClaimTransition[]         @relation("claim_transition_evidence")
  adjudicationDecisions        AdjudicationDecision[]    @relation("decision_evidence")
  remedyTransitions            RemedyTransition[]        @relation("remedy_transition_evidence")

  @@unique([issuer, digest])
  @@index([kind, observedAt])
}

model ActorEvidenceBinding {
  id                 String   @id
  actorId            String
  evidenceArtifactId String
  role               String
  boundAt            DateTime @default(now())
  metadata           Json     @default("{}")

  actor    Actor            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  artifact EvidenceArtifact @relation(fields: [evidenceArtifactId], references: [id], onDelete: Restrict)

  @@unique([actorId, evidenceArtifactId, role])
  @@index([actorId, boundAt])
  @@index([evidenceArtifactId, role])
}

model EvidenceValidation {
  id                 String                   @id
  evidenceArtifactId String
  validator          String
  status             EvidenceValidationStatus
  method             String?
  reason             String?
  checkedAt          DateTime                 @default(now())
  idempotencyKey     String                   @unique
  metadata           Json                     @default("{}")

  artifact EvidenceArtifact @relation(fields: [evidenceArtifactId], references: [id], onDelete: Cascade)

  @@index([evidenceArtifactId, checkedAt])
  @@index([validator, status, checkedAt])
}

model Commitment {
  id                       String           @id
  debtorActorId            String
  creditorActorId          String?
  creditorExternalRef      String?
  kind                     String
  status                   CommitmentStatus @default(OPEN)
  termsDigest              String
  termsUri                 String?
  sourceEvidenceArtifactId String?
  externalFramework        String?
  externalReference        String?
  dueAt                    DateTime?
  openedAt                 DateTime         @default(now())
  closedAt                 DateTime?
  createdByType            String
  createdById              String?
  idempotencyKey           String           @unique
  metadata                 Json             @default("{}")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  debtor         Actor                    @relation("commitment_debtor", fields: [debtorActorId], references: [id], onDelete: Restrict)
  creditor       Actor?                   @relation("commitment_creditor", fields: [creditorActorId], references: [id], onDelete: Restrict)
  sourceEvidence EvidenceArtifact?        @relation("commitment_source_evidence", fields: [sourceEvidenceArtifactId], references: [id], onDelete: Restrict)
  transitions    CommitmentTransition[]
  consequences   ConsequenceObservation[]
  claims         Claim[]

  @@index([debtorActorId, status, dueAt])
  @@index([creditorActorId, status, dueAt])
  @@index([sourceEvidenceArtifactId])
  @@index([externalFramework, externalReference])
}

model CommitmentTransition {
  id                 String            @id
  commitmentId       String
  fromStatus         CommitmentStatus?
  toStatus           CommitmentStatus
  evidenceArtifactId String?
  reason             String?
  decidedByType      String
  decidedById        String?
  idempotencyKey     String            @unique
  occurredAt         DateTime          @default(now())
  metadata           Json              @default("{}")

  commitment Commitment        @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  evidence   EvidenceArtifact? @relation("commitment_transition_evidence", fields: [evidenceArtifactId], references: [id], onDelete: Restrict)

  @@index([commitmentId, occurredAt])
  @@index([evidenceArtifactId])
}

model AuthorityGrant {
  id                       String               @id
  subjectActorId           String
  parentGrantId            String?
  grantorType              String
  grantorRef               String
  status                   AuthorityGrantStatus @default(ACTIVE)
  actions                  String[]
  resources                String[]
  canRedelegate            Boolean              @default(false)
  remainingDelegationDepth Int                  @default(0)
  maxAmountMinor           String?
  currency                 String?
  notBefore                DateTime             @default(now())
  expiresAt                DateTime?
  externalFramework        String?
  externalReference        String?
  sourceEvidenceArtifactId String?
  issuedByType             String
  issuedById               String?
  idempotencyKey           String               @unique
  revokedAt                DateTime?
  revokedByType            String?
  revokedById              String?
  revocationReason         String?
  metadata                 Json                 @default("{}")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  subject        Actor                       @relation("authority_subject", fields: [subjectActorId], references: [id], onDelete: Restrict)
  parent         AuthorityGrant?             @relation("authority_parent", fields: [parentGrantId], references: [id], onDelete: Restrict)
  children       AuthorityGrant[]            @relation("authority_parent")
  sourceEvidence EvidenceArtifact?           @relation("authority_evidence", fields: [sourceEvidenceArtifactId], references: [id], onDelete: Restrict)
  transitions    AuthorityGrantTransition[]
  exercises      AuthorityExercise[]

  @@index([subjectActorId, status, expiresAt])
  @@index([parentGrantId])
  @@index([grantorType, grantorRef])
  @@index([externalFramework, externalReference])
  @@index([sourceEvidenceArtifactId])
}

model AuthorityGrantTransition {
  id             String               @id
  grantId        String
  fromStatus     AuthorityGrantStatus?
  toStatus       AuthorityGrantStatus
  reason         String?
  decidedByType  String
  decidedById    String?
  idempotencyKey String               @unique
  occurredAt     DateTime             @default(now())
  metadata       Json                 @default("{}")

  grant AuthorityGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, occurredAt])
}

model AuthorityExercise {
  id                 String                    @id
  actorId            String
  executionId        String?
  grantId            String
  evidenceArtifactId String
  action             String
  resource           String
  amountMinor        String?
  currency           String?
  exercisedAt        DateTime
  coverageStatus     AuthorityExerciseCoverage
  chainDigest        String
  requestDigest      String
  evaluatorVersion   String
  reasons            String[]
  idempotencyKey     String                    @unique
  metadata           Json                      @default("{}")
  createdAt          DateTime                  @default(now())

  actor        Actor            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  execution    ActorExecution?  @relation(fields: [executionId], references: [id], onDelete: SetNull)
  grant        AuthorityGrant   @relation(fields: [grantId], references: [id], onDelete: Restrict)
  evidence     EvidenceArtifact @relation("authority_exercise_evidence", fields: [evidenceArtifactId], references: [id], onDelete: Restrict)
  consequences ConsequenceObservation[]
  claims       Claim[]

  @@index([actorId, exercisedAt])
  @@index([grantId, exercisedAt])
  @@index([evidenceArtifactId])
  @@index([executionId])
}

model ConsequenceObservation {
  id                        String   @id
  kind                      String
  sourceEvidenceArtifactId  String
  sourceAuthorityExerciseId String?
  commitmentId              String?
  occurredAt                DateTime
  valueMinor                String?
  currency                  String?
  externalFramework         String?
  externalReference         String?
  idempotencyKey            String   @unique
  metadata                  Json     @default("{}")
  createdAt                 DateTime @default(now())

  sourceEvidence          EvidenceArtifact        @relation("consequence_source_evidence", fields: [sourceEvidenceArtifactId], references: [id], onDelete: Restrict)
  sourceAuthorityExercise AuthorityExercise?      @relation(fields: [sourceAuthorityExerciseId], references: [id], onDelete: Restrict)
  commitment              Commitment?             @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  attributions            ConsequenceAttribution[]
  claims                  Claim[]

  @@index([kind, occurredAt])
  @@index([sourceEvidenceArtifactId])
  @@index([sourceAuthorityExerciseId])
  @@index([commitmentId])
}

model ConsequenceAttribution {
  id                       String                             @id
  consequenceId            String
  actorId                  String
  assessmentType           String
  disposition              ConsequenceAttributionDisposition
  method                   String
  methodVersion            String
  evaluator                String
  scoreBps                 Int?
  sourceEvidenceArtifactId String?
  basisDigest              String
  idempotencyKey           String                             @unique
  metadata                 Json                               @default("{}")
  createdAt                DateTime                           @default(now())

  consequence    ConsequenceObservation @relation(fields: [consequenceId], references: [id], onDelete: Cascade)
  actor          Actor                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  sourceEvidence EvidenceArtifact?      @relation("consequence_attribution_evidence", fields: [sourceEvidenceArtifactId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([consequenceId, createdAt])
  @@index([method, methodVersion])
  @@index([sourceEvidenceArtifactId])
}

model LegalContextSnapshot {
  id                           String   @id
  framework                    String
  termsDigest                  String
  termsUri                     String?
  disputeClauseDigest          String?
  method                       String?
  jurisdiction                 String?
  forumRef                     String?
  acceptanceEvidenceArtifactId String?
  sourceEvidenceArtifactId     String?
  effectiveAt                  DateTime
  capturedAt                   DateTime @default(now())
  contextDigest                String
  idempotencyKey               String   @unique
  metadata                     Json     @default("{}")

  acceptanceEvidence EvidenceArtifact?     @relation("legal_context_acceptance_evidence", fields: [acceptanceEvidenceArtifactId], references: [id], onDelete: Restrict)
  sourceEvidence     EvidenceArtifact?     @relation("legal_context_source_evidence", fields: [sourceEvidenceArtifactId], references: [id], onDelete: Restrict)
  claims             Claim[]
  decisions          AdjudicationDecision[]

  @@index([framework, effectiveAt])
  @@index([termsDigest])
  @@index([disputeClauseDigest])
  @@index([forumRef])
}

model Claim {
  id                          String      @id
  claimType                   String
  status                      ClaimStatus @default(FILED)
  consequenceId               String?
  commitmentId                String?
  authorityExerciseId         String?
  legalContextSnapshotId      String?
  statementEvidenceArtifactId String
  claimDigest                 String
  amountMinor                 String?
  currency                    String?
  externalFramework           String?
  externalReference           String?
  appealOfClaimId             String?
  filedAt                     DateTime
  idempotencyKey              String      @unique
  metadata                    Json        @default("{}")
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  consequence          ConsequenceObservation? @relation(fields: [consequenceId], references: [id], onDelete: Restrict)
  commitment           Commitment?            @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  authorityExercise    AuthorityExercise?      @relation(fields: [authorityExerciseId], references: [id], onDelete: Restrict)
  legalContext         LegalContextSnapshot?   @relation(fields: [legalContextSnapshotId], references: [id], onDelete: Restrict)
  statementEvidence    EvidenceArtifact        @relation("claim_statement_evidence", fields: [statementEvidenceArtifactId], references: [id], onDelete: Restrict)
  appealOf             Claim?                  @relation("claim_appeal", fields: [appealOfClaimId], references: [id], onDelete: Restrict)
  appeals              Claim[]                 @relation("claim_appeal")
  parties              ClaimParty[]
  actorLinks           ClaimActorLink[]
  evidenceBindings     ClaimEvidenceBinding[]
  transitions          ClaimTransition[]
  decisions            AdjudicationDecision[]
  remedies             RemedyOrder[]

  @@index([status, filedAt])
  @@index([consequenceId])
  @@index([commitmentId])
  @@index([authorityExerciseId])
  @@index([legalContextSnapshotId])
  @@index([appealOfClaimId])
  @@index([externalFramework, externalReference])
}

model ClaimParty {
  id                         String         @id
  claimId                    String
  role                       ClaimPartyRole
  principalType              String
  principalRef               String
  identityEvidenceArtifactId String?
  createdAt                  DateTime       @default(now())
  metadata                   Json           @default("{}")

  claim            Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  identityEvidence EvidenceArtifact? @relation("claim_party_identity_evidence", fields: [identityEvidenceArtifactId], references: [id], onDelete: Restrict)
  evidenceBindings ClaimEvidenceBinding[]
  remedyObligations RemedyOrder[]     @relation("remedy_obligor_party")
  remedyBenefits    RemedyOrder[]     @relation("remedy_beneficiary_party")

  @@unique([claimId, role, principalType, principalRef])
  @@index([principalType, principalRef])
  @@index([identityEvidenceArtifactId])
}

model ClaimActorLink {
  id        String         @id
  claimId   String
  actorId   String
  role      ClaimActorRole
  createdAt DateTime       @default(now())
  metadata  Json           @default("{}")

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([claimId, actorId, role])
  @@index([actorId, createdAt])
}

model ClaimEvidenceBinding {
  id                 String   @id
  claimId            String
  evidenceArtifactId String
  role               String
  submittedByPartyId String?
  submittedAt        DateTime @default(now())
  idempotencyKey     String   @unique
  metadata           Json     @default("{}")

  claim       Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence    EvidenceArtifact @relation(fields: [evidenceArtifactId], references: [id], onDelete: Restrict)
  submittedBy ClaimParty?      @relation(fields: [submittedByPartyId], references: [id], onDelete: Restrict)

  @@index([claimId, submittedAt])
  @@index([evidenceArtifactId])
  @@index([submittedByPartyId])
}

model ClaimTransition {
  id                 String      @id
  claimId            String
  fromStatus         ClaimStatus?
  toStatus           ClaimStatus
  evidenceArtifactId String?
  decidedByType      String
  decidedByRef       String?
  reason             String?
  occurredAt         DateTime    @default(now())
  idempotencyKey     String      @unique
  metadata           Json        @default("{}")

  claim    Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence EvidenceArtifact? @relation("claim_transition_evidence", fields: [evidenceArtifactId], references: [id], onDelete: Restrict)

  @@index([claimId, occurredAt])
  @@index([evidenceArtifactId])
}

model AdjudicationDecision {
  id                         String                  @id
  claimId                    String
  disposition                AdjudicationDisposition
  adjudicatorType            String
  adjudicatorRef             String
  decisionEvidenceArtifactId String
  decisionDigest             String
  legalContextSnapshotId     String?
  decidedAt                  DateTime
  externalFramework          String?
  externalReference          String?
  idempotencyKey             String                  @unique
  metadata                   Json                    @default("{}")
  createdAt                  DateTime                @default(now())

  claim            Claim                @relation(fields: [claimId], references: [id], onDelete: Restrict)
  decisionEvidence EvidenceArtifact     @relation("decision_evidence", fields: [decisionEvidenceArtifactId], references: [id], onDelete: Restrict)
  legalContext     LegalContextSnapshot? @relation(fields: [legalContextSnapshotId], references: [id], onDelete: Restrict)
  remedies         RemedyOrder[]

  @@index([claimId, decidedAt])
  @@index([adjudicatorType, adjudicatorRef])
  @@index([decisionEvidenceArtifactId])
  @@index([externalFramework, externalReference])
}

model RemedyOrder {
  id                          String       @id
  claimId                     String
  decisionId                  String?
  kind                        String
  obligorPrincipalPartyId     String
  beneficiaryPrincipalPartyId String
  amountMinor                 String?
  currency                    String?
  termsDigest                 String
  dueAt                       DateTime?
  status                      RemedyStatus @default(ORDERED)
  idempotencyKey              String       @unique
  metadata                    Json         @default("{}")
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  claim       Claim                @relation(fields: [claimId], references: [id], onDelete: Restrict)
  decision    AdjudicationDecision? @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  obligor     ClaimParty           @relation("remedy_obligor_party", fields: [obligorPrincipalPartyId], references: [id], onDelete: Restrict)
  beneficiary ClaimParty           @relation("remedy_beneficiary_party", fields: [beneficiaryPrincipalPartyId], references: [id], onDelete: Restrict)
  transitions RemedyTransition[]

  @@index([claimId, status, dueAt])
  @@index([decisionId])
  @@index([obligorPrincipalPartyId])
  @@index([beneficiaryPrincipalPartyId])
}

model RemedyTransition {
  id                 String       @id
  remedyId           String
  fromStatus         RemedyStatus?
  toStatus           RemedyStatus
  evidenceArtifactId String?
  decidedByType      String
  decidedByRef       String?
  reason             String?
  occurredAt         DateTime     @default(now())
  idempotencyKey     String       @unique
  metadata           Json         @default("{}")

  remedy   RemedyOrder       @relation(fields: [remedyId], references: [id], onDelete: Cascade)
  evidence EvidenceArtifact? @relation("remedy_transition_evidence", fields: [evidenceArtifactId], references: [id], onDelete: Restrict)

  @@index([remedyId, occurredAt])
  @@index([evidenceArtifactId])
}

model Follow {
  userId    String
  actorId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([userId, actorId])
  @@index([actorId, createdAt])
}

model RelationshipEdge {
  id              String   @id @default(cuid())
  subjectActorId  String
  objectActorId   String
  relation        String
  firstObservedAt DateTime
  lastObservedAt  DateTime
  eventCount      Int      @default(1)
  metadata        Json     @default("{}")

  subject Actor @relation("relationship_subject", fields: [subjectActorId], references: [id], onDelete: Cascade)
  object  Actor @relation("relationship_object", fields: [objectActorId], references: [id], onDelete: Cascade)

  @@unique([subjectActorId, objectActorId, relation])
  @@index([subjectActorId, relation, lastObservedAt])
  @@index([objectActorId, relation, lastObservedAt])
}

model Match {
  id            String      @id
  environmentId String
  actorAId      String
  actorBId      String
  winnerActorId String?
  status        MatchStatus @default(SCHEDULED)
  scheduledAt   DateTime    @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  seed          String?
  result        Json?
  trajectory    Json?
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  actorA      Actor       @relation("match_actor_a", fields: [actorAId], references: [id], onDelete: Restrict)
  actorB      Actor       @relation("match_actor_b", fields: [actorBId], references: [id], onDelete: Restrict)
  winner      Actor?      @relation("match_winner", fields: [winnerActorId], references: [id], onDelete: SetNull)

  @@index([environmentId, status, scheduledAt])
  @@index([actorAId, completedAt])
  @@index([actorBId, completedAt])
}