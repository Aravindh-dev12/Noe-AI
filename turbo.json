{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "ADMIN_API_KEY",
    "EVENT_SIGNING_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CORS_ORIGINS",
    "TRUST_PROXY",
    "USER_MODEL_ALLOWLIST",
    "MAX_USER_ACTORS",
    "LOG_LEVEL",
    "ONBAE_API_URL",
    "NEXT_PUBLIC_API_URL",
    "API_PORT",
    "WORKER_CONCURRENCY",
    "MODEL_REQUEST_TIMEOUT_MS",
    "MAX_MODEL_TOKENS",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}